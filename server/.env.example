# Server configuration
PORT=5000

# Secret used to sign JWTs (change this in production!)
JWT_SECRET=ganti-dengan-secret-panjang-acak

# Database & storage paths (relative to server/)
DATABASE_PATH=./data/sulap-photo.sqlite
STORAGE_DIR=./storage

# Credits given to a new account
FREE_CREDITS=500

# --- AI provider defaults ---
# 'pollinations' -> free, no API key needed (txt2img only)
# 'openai'       -> OpenAI-compatible API (user or server API key)
# 'gemini'       -> Google Gemini (generativelanguage.googleapis.com)
DEFAULT_PROVIDER=pollinations

# OpenAI-compatible endpoint + key (optional, used when user has no own key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1

# Google Gemini (optional; per-user key configured in Pengaturan > AI Providers)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Model default bila user tidak set. Model image-generation Gemini (2026):
# gemini-2.5-flash-image (Nano Banana, stable) | gemini-3.1-flash-image-preview | gemini-3-pro-image-preview
GEMINI_MODEL=gemini-2.5-flash-image

# Model used by the free Pollinations provider
POLLINATIONS_MODEL=flux

# Admin API key to grant credits (POST /api/admin/credits)
ADMIN_API_KEY=ganti-dengan-admin-key

# Max upload size in MB
MAX_UPLOAD_MB=10
